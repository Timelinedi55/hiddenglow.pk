DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=hiddenglow
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=hiddenglow_db

# Generate with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_change_this_in_production

# Seeded on first boot only, when the admin_user table is empty.
ADMIN_DEFAULT_EMAIL=admin@hiddenglow.pk
ADMIN_DEFAULT_PASSWORD=Admin@123

UPLOAD_DIR=./uploads
PORT=4001

# Allowed CORS origin(s), comma-separated.
FRONTEND_URL=https://hiddenglow.pk
