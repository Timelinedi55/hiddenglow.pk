'use client';

import { useState, useEffect, useRef } from 'react';
import { useParams, useRouter } from 'next/navigation';
import Link from 'next/link';
import { api } from '@/lib/api';
import { Product, ProductVariant } from '@/lib/types';
import { useCartStore } from '@/lib/store';
import { formatPrice, getDiscount } from '@/lib/utils';
import ProductCard from '@/components/ProductCard';
import toast from 'react-hot-toast';
import { HiStar, HiOutlineTruck, HiOutlineShieldCheck, HiOutlineRefresh, HiChevronRight, HiChevronLeft, HiMinus, HiPlus } from 'react-icons/hi';
import { FiShare2 } from 'react-icons/fi';
import MediaImage from '@/components/MediaImage';

export default function ProductPage() {
  const params = useParams();
  const router = useRouter();
  const slug = params.slug as string;
  const [product, setProduct] = useState<Product | null>(null);
  const [related, setRelated] = useState<Product[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedImage, setSelectedImage] = useState(0);
  const [selectedVariant, setSelectedVariant] = useState<ProductVariant | null>(null);
  const [quantity, setQuantity] = useState(1);
  const [activeTab, setActiveTab] = useState<'description' | 'reviews'>('description');
  const addItem = useCartStore((s) => s.addItem);
  const galleryRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    setLoading(true);
    setSelectedImage(0);
    setSelectedVariant(null);
    setQuantity(1);

    api.get(`/products/slug/${slug}`).then((p) => {
      setProduct(p);
      if (p.variants?.length) setSelectedVariant(p.variants[0]);
      setLoading(false);
      if (p.categoryId) {
        api.get(`/products/${p.id}/related?categoryId=${p.categoryId}`).then(setRelated).catch(() => {});
      }
    }).catch(() => setLoading(false));
  }, [slug]);

  const buildCartItem = () => {
    if (!product) return;
    if (product.variants?.length && !selectedVariant) {
      toast.error('Please select a size');
      return null;
    }
    const primaryImage = product.images?.find((i: any) => i.isPrimary) || product.images?.[0];
    return {
      productId: product.id,
      variantId: selectedVariant?.id,
      name: product.name,
      price: product.discountPrice || product.price,
      size: selectedVariant?.size,
      color: selectedVariant?.color,
      quantity,
      image: primaryImage?.url || '',
      slug: product.slug,
    };
  };

  const handleAddToCart = () => {
    const cartItem = buildCartItem();
    if (!cartItem) return;
    addItem(cartItem);
    toast.success('Added to cart!');
  };

  const handleBuyNow = () => {
    const cartItem = buildCartItem();
    if (!cartItem) return;
    addItem(cartItem);
    router.push('/checkout');
  };

  const handleShare = () => {
    if (navigator.share) {
      navigator.share({ title: product?.name, url: window.location.href });
    } else {
      navigator.clipboard.writeText(window.location.href);
      toast.success('Link copied!');
    }
  };

  if (loading) {
    return (
      <div className="container-custom py-6 md:py-10">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
          <div>
            <div className="skeleton aspect-square rounded-2xl mb-3" />
            <div className="grid grid-cols-4 gap-2">
              {[...Array(4)].map((_, i) => <div key={i} className="skeleton aspect-square rounded-lg" />)}
            </div>
          </div>
          <div className="py-2">
            <div className="skeleton h-4 w-20 mb-3 rounded" />
            <div className="skeleton h-9 w-3/4 mb-4 rounded" />
            <div className="skeleton h-6 w-1/3 mb-6 rounded" />
            <div className="skeleton h-4 w-full mb-2 rounded" />
            <div className="skeleton h-4 w-5/6 mb-8 rounded" />
            <div className="skeleton h-14 w-full mb-3 rounded-lg" />
            <div className="skeleton h-14 w-full rounded-lg" />
          </div>
        </div>
      </div>
    );
  }

  if (!product) {
    return (
      <div className="container-custom py-20 text-center">
        <h1 className="heading-2 mb-4">Product Not Found</h1>
        <p className="text-gray-500 mb-6">This product may have been removed or the link is incorrect.</p>
        <Link href="/shop" className="btn-primary">Back to Shop</Link>
      </div>
    );
  }

  const discount = getDiscount(product.price, product.discountPrice);
  const sizes = Array.from(new Set(product.variants?.map((v: any) => v.size) || []));
  const approvedReviews = product.reviews?.filter((r: any) => r.isApproved) || [];
  const avgRating = approvedReviews.length > 0 ? approvedReviews.reduce((sum: number, r: any) => sum + r.rating, 0) / approvedReviews.length : 0;
  const images = product.images || [];
  const maxQuantity = selectedVariant ? selectedVariant.stock : 99;

  return (
    <>
      <div className="container-custom py-4 md:py-6">
        {/* Breadcrumb */}
        <nav aria-label="Breadcrumb" className="flex items-center gap-1.5 text-sm text-gray-500 mb-4 md:mb-6 overflow-x-auto whitespace-nowrap">
          <Link href="/" className="hover:text-brand-dark">Home</Link>
          <HiChevronRight className="w-3 h-3 flex-shrink-0" />
          <Link href="/shop" className="hover:text-brand-dark">Shop</Link>
          {product.category && (
            <>
              <HiChevronRight className="w-3 h-3 flex-shrink-0" />
              <Link href={`/category/${product.category.slug}`} className="hover:text-brand-dark">{product.category.name}</Link>
            </>
          )}
          <HiChevronRight className="w-3 h-3 flex-shrink-0" />
          <span className="text-brand-dark font-medium truncate">{product.name}</span>
        </nav>

        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
          {/* IMAGE GALLERY */}
          <div>
            {/* Mobile: Horizontal swipeable gallery */}
            <div className="lg:hidden relative">
              <div
                ref={galleryRef}
                className="flex gap-0 overflow-x-auto snap-x snap-mandatory scrollbar-hide rounded-2xl"
                onScroll={(e) => {
                  const el = e.currentTarget;
                  const idx = Math.round(el.scrollLeft / el.clientWidth);
                  setSelectedImage(idx);
                }}
              >
                {images.length > 0 ? images.map((img: any, i: number) => (
                  <div key={img.id} className="flex-shrink-0 w-full snap-center">
                    <div className="aspect-[4/5] bg-brand-bg rounded-2xl overflow-hidden">
                      <MediaImage
                        src={img.url}
                        alt={`${product.name} - Image ${i + 1}`}
                        sizes="100vw"
                        priority={i === 0}
                        className="w-full h-full object-cover"
                      />
                    </div>
                  </div>
                )) : (
                  <div className="w-full aspect-[4/5] bg-brand-bg rounded-2xl flex items-center justify-center text-gray-400">
                    No Image
                  </div>
                )}
              </div>
              {/* Dots indicator */}
              {images.length > 1 && (
                <div className="flex justify-center gap-1.5 mt-3" role="tablist" aria-label="Product images">
                  {images.map((_: any, i: number) => (
                    <button
                      key={i}
                      role="tab"
                      aria-selected={selectedImage === i}
                      aria-label={`View image ${i + 1}`}
                      onClick={() => {
                        galleryRef.current?.scrollTo({ left: i * (galleryRef.current?.clientWidth || 0), behavior: 'smooth' });
                        setSelectedImage(i);
                      }}
                      className={`h-2 rounded-full transition-all ${selectedImage === i ? 'bg-brand-primary w-6' : 'bg-gray-300 w-2'}`}
                    />
                  ))}
                </div>
              )}
              {discount > 0 && (
                <span className="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-2.5 py-1 rounded-full z-10">
                  -{discount}%
                </span>
              )}
              {product.isBestSeller && (
                <span className="absolute top-3 right-3 bg-brand-accent text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider z-10">
                  Best Seller
                </span>
              )}
            </div>

            {/* Desktop: Main image + thumbnails */}
            <div className="hidden lg:block">
              <div className="relative aspect-square bg-brand-bg rounded-2xl overflow-hidden mb-3 group">
                {images.length > 0 ? (
                  <MediaImage
                    src={images[selectedImage]?.url}
                    alt={product.name}
                    sizes="50vw"
                    priority
                    className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div className="w-full h-full flex items-center justify-center text-gray-400">No Image</div>
                )}
                {images.length > 1 && (
                  <>
                    <button
                      onClick={() => setSelectedImage(Math.max(0, selectedImage - 1))}
                      aria-label="Previous image"
                      className={`absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow transition-opacity ${selectedImage === 0 ? 'opacity-0 pointer-events-none' : 'opacity-0 group-hover:opacity-100'}`}
                    >
                      <HiChevronLeft className="w-5 h-5" />
                    </button>
                    <button
                      onClick={() => setSelectedImage(Math.min(images.length - 1, selectedImage + 1))}
                      aria-label="Next image"
                      className={`absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 bg-white/80 hover:bg-white rounded-full flex items-center justify-center shadow transition-opacity ${selectedImage === images.length - 1 ? 'opacity-0 pointer-events-none' : 'opacity-0 group-hover:opacity-100'}`}
                    >
                      <HiChevronRight className="w-5 h-5" />
                    </button>
                  </>
                )}
                {discount > 0 && (
                  <span className="absolute top-4 left-4 bg-red-500 text-white text-sm font-bold px-3 py-1 rounded-full">
                    -{discount}%
                  </span>
                )}
                {product.isBestSeller && (
                  <span className="absolute top-4 right-4 bg-brand-accent text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                    Best Seller
                  </span>
                )}
              </div>
              {images.length > 1 && (
                <div className="grid grid-cols-5 gap-2">
                  {images.map((img: any, i: number) => (
                    <button
                      key={img.id}
                      onClick={() => setSelectedImage(i)}
                      className={`aspect-square rounded-xl overflow-hidden border-2 transition-all ${
                        selectedImage === i ? 'border-brand-primary ring-2 ring-brand-primary/20' : 'border-transparent hover:border-gray-200'
                      }`}
                    >
                      <MediaImage src={img.url} alt={`View ${i + 1}`} sizes="100px" className="w-full h-full object-cover" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>

          {/* PRODUCT INFO */}
          <div className="flex flex-col">
            <div className="flex items-center justify-between mb-2">
              {product.category ? (
                <Link href={`/category/${product.category.slug}`} className="text-sm text-brand-primary hover:underline">
                  {product.category.name}
                </Link>
              ) : <span />}
              <button onClick={handleShare} className="p-2 text-gray-400 hover:text-brand-dark transition-colors" aria-label="Share">
                <FiShare2 className="w-4 h-4" />
              </button>
            </div>

            <h1 className="text-2xl md:text-3xl font-serif font-bold text-brand-dark mb-3">{product.name}</h1>

            {approvedReviews.length > 0 && (
              <button onClick={() => setActiveTab('reviews')} className="flex items-center gap-2 mb-3">
                <div className="flex gap-0.5">
                  {[...Array(5)].map((_, i) => (
                    <HiStar key={i} className={`w-4 h-4 ${i < Math.round(avgRating) ? 'text-yellow-400' : 'text-gray-200'}`} />
                  ))}
                </div>
                <span className="text-sm text-gray-500 hover:text-brand-dark">
                  {avgRating.toFixed(1)} ({approvedReviews.length})
                </span>
              </button>
            )}

            <div className="flex items-baseline gap-3 mb-4">
              {product.discountPrice ? (
                <>
                  <span className="text-2xl md:text-3xl font-bold text-brand-dark">{formatPrice(product.discountPrice)}</span>
                  <span className="text-base text-gray-400 line-through">{formatPrice(product.price)}</span>
                  <span className="bg-red-50 text-red-600 text-sm font-bold px-2.5 py-1 rounded-full">Save {discount}%</span>
                </>
              ) : (
                <span className="text-2xl md:text-3xl font-bold text-brand-dark">{formatPrice(product.price)}</span>
              )}
            </div>

            {selectedVariant && selectedVariant.stock > 0 && selectedVariant.stock < 10 && (
              <p className="text-sm text-brand-accent font-medium mb-3 flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 bg-brand-accent rounded-full animate-pulse" />
                Only {selectedVariant.stock} left in stock
              </p>
            )}

            {product.shortDescription && (
              <p className="text-gray-600 mb-5 leading-relaxed text-sm md:text-base">{product.shortDescription}</p>
            )}

            <div className="border-t border-gray-100 my-1" />

            {sizes.length > 0 && (
              <div className="my-5">
                <div className="flex items-center justify-between mb-3">
                  <h3 className="font-semibold text-sm text-brand-dark">Size</h3>
                  {selectedVariant && <span className="text-xs text-gray-400">Selected: {selectedVariant.size}</span>}
                </div>
                <div className="flex flex-wrap gap-2">
                  {sizes.map((size: string) => {
                    const variant = product.variants?.find((v: any) => v.size === size);
                    const isSelected = selectedVariant?.size === size;
                    const outOfStock = variant && variant.stock <= 0;
                    return (
                      <button
                        key={size}
                        onClick={() => !outOfStock && setSelectedVariant(variant!)}
                        disabled={outOfStock}
                        className={`min-w-[52px] h-11 px-4 rounded-lg border-2 text-sm font-medium transition-all ${
                          isSelected ? 'border-brand-primary bg-brand-primary text-white shadow-md shadow-brand-primary/20' :
                          outOfStock ? 'border-gray-100 text-gray-300 cursor-not-allowed bg-gray-50 line-through' :
                          'border-gray-200 hover:border-brand-primary text-brand-dark'
                        }`}
                      >
                        {size}
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            <div className="mb-5">
              <h3 className="font-semibold text-sm text-brand-dark mb-3">Quantity</h3>
              <div className="inline-flex items-center border-2 border-gray-200 rounded-lg">
                <button onClick={() => setQuantity(Math.max(1, quantity - 1))} className="w-11 h-11 flex items-center justify-center hover:bg-gray-50 transition-colors">
                  <HiMinus className="w-4 h-4" />
                </button>
                <span className="w-12 text-center font-medium text-sm">{quantity}</span>
                <button onClick={() => setQuantity(Math.min(maxQuantity, quantity + 1))} disabled={quantity >= maxQuantity} className="w-11 h-11 flex items-center justify-center hover:bg-gray-50 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                  <HiPlus className="w-4 h-4" />
                </button>
              </div>
            </div>

            <div className="hidden md:grid gap-3 sm:grid-cols-2 mb-6">
              <button onClick={handleAddToCart} className="btn-primary py-4 text-base">Add to Cart</button>
              <button onClick={handleBuyNow} className="py-4 text-base rounded-lg font-semibold bg-brand-accent text-white hover:bg-brand-dark transition-colors inline-flex items-center justify-center">Buy Now</button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-gray-100 pt-5 mt-auto">
              <div className="flex items-center gap-2.5">
                <div className="w-9 h-9 bg-brand-bg rounded-full flex items-center justify-center flex-shrink-0">
                  <HiOutlineTruck className="w-4 h-4 text-brand-dark" />
                </div>
                <span className="text-xs text-gray-600">Free delivery over Rs. 3,000</span>
              </div>
              <div className="flex items-center gap-2.5">
                <div className="w-9 h-9 bg-brand-bg rounded-full flex items-center justify-center flex-shrink-0">
                  <HiOutlineShieldCheck className="w-4 h-4 text-brand-dark" />
                </div>
                <span className="text-xs text-gray-600">Cash on Delivery</span>
              </div>
              <div className="flex items-center gap-2.5">
                <div className="w-9 h-9 bg-brand-bg rounded-full flex items-center justify-center flex-shrink-0">
                  <HiOutlineRefresh className="w-4 h-4 text-brand-dark" />
                </div>
                <span className="text-xs text-gray-600">7-day exchange</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Tabs: Description & Reviews */}
      <div className="container-custom pb-8 md:pb-12">
        <div className="border-t border-gray-100 pt-8 md:pt-12">
          <div className="flex gap-6 border-b border-gray-200 mb-6">
            <button onClick={() => setActiveTab('description')}
              className={`pb-3 text-sm font-semibold transition-colors border-b-2 -mb-px ${activeTab === 'description' ? 'border-brand-primary text-brand-dark' : 'border-transparent text-gray-400 hover:text-gray-600'}`}>
              Product Details
            </button>
            {approvedReviews.length > 0 && (
              <button onClick={() => setActiveTab('reviews')}
                className={`pb-3 text-sm font-semibold transition-colors border-b-2 -mb-px ${activeTab === 'reviews' ? 'border-brand-primary text-brand-dark' : 'border-transparent text-gray-400 hover:text-gray-600'}`}>
                Reviews ({approvedReviews.length})
              </button>
            )}
          </div>
          {activeTab === 'description' && product.description && (
            <div className="max-w-3xl"><div className="cms-content text-gray-600" dangerouslySetInnerHTML={{ __html: product.description }} /></div>
          )}
          {activeTab === 'reviews' && approvedReviews.length > 0 && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-4xl">
              {approvedReviews.map((review: any) => (
                <div key={review.id} className="bg-brand-bg/40 border border-brand-secondary/20 p-5 rounded-xl">
                  <div className="flex gap-0.5 mb-2">
                    {[...Array(5)].map((_, i) => (
                      <HiStar key={i} className={`w-4 h-4 ${i < review.rating ? 'text-yellow-400' : 'text-gray-200'}`} />
                    ))}
                  </div>
                  <p className="text-gray-600 text-sm mb-3 leading-relaxed">{review.comment}</p>
                  <div className="flex items-center gap-2">
                    <div className="w-7 h-7 rounded-full bg-brand-primary flex items-center justify-center text-white text-xs font-bold">{review.name.charAt(0)}</div>
                    <span className="text-xs font-semibold text-brand-dark">{review.name}</span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {related.length > 0 && (
        <section className="py-10 md:py-16 bg-brand-bg/50">
          <div className="container-custom">
            <h2 className="heading-3 text-brand-dark mb-6 md:mb-8">You May Also Like</h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6">
              {related.filter((r: any) => r.id !== product.id).slice(0, 4).map((p: any) => (
                <ProductCard key={p.id} product={p} />
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Sticky Mobile Buy Bar */}
      <div className="fixed bottom-0 left-0 right-0 bg-white border-t shadow-[0_-4px_20px_rgba(0,0,0,0.08)] p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden z-40">
        <div className="flex items-center gap-3">
          <div className="flex-shrink-0">
            <p className="text-[10px] text-gray-500 leading-none mb-0.5">Total</p>
            <p className="text-base font-bold text-brand-dark leading-none">{formatPrice((product.discountPrice || product.price) * quantity)}</p>
          </div>
          <button onClick={handleAddToCart} className="btn-outline py-2.5 px-3 text-sm flex-shrink-0">Add</button>
          <button onClick={handleBuyNow} className="btn-primary py-2.5 flex-1 text-sm">Buy Now</button>
        </div>
      </div>
      <div className="h-20 md:hidden" />
    </>
  );
}
