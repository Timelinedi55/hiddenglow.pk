# Copy to .env.local for development, or .env.production.local for a production build.
# These are baked into the client bundle at build time — rebuild after changing them.

# Development values:
NEXT_PUBLIC_API_URL=http://localhost:4001/api
NEXT_PUBLIC_UPLOADS_URL=http://localhost:4001/uploads
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production values (served behind nginx on one domain):
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_UPLOADS_URL=https://your-domain.com/uploads
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
